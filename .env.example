# Copy to .env and fill in. Never commit .env or .p8 keys.
POSTGRES_USER=album
POSTGRES_PASSWORD=album
POSTGRES_DB=album
POSTGRES_PORT=5432
# Postgres via docker (pnpm db). For a no-Docker setup use: DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://album:album@localhost:5432/album

# API
WEB_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=change-me

# MusicKit developer token. Leave empty to use the demo player (no audio).
# APPLE_PRIVATE_KEY_PATH points at your .p8 file (keep it outside the repo).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: force a player ("fake" or "musickit"). Default: musickit when the API has Apple credentials, else fake.
# NEXT_PUBLIC_PLAYER=fake
