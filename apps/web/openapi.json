  "info": {
    "title": "Album Deep-Dive API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/claims": {
      "get": {
        "description": "Claims awaiting review, with sources and anything blocking approval. Flagged first.",
        "operationId": "review_queue_admin_claims_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Status",
              "default": "draft"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AdminClaimOut"
                  },
                  "title": "Response Review Queue Admin Claims Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "summary": "Review Queue"
      }
    },
    "/admin/claims/{claim_id}": {
      "patch": {
        "description": "Approve, reject or edit. 422 (with the reasons) if a claim rule fails; nothing is saved.",
        "operationId": "update_claim_admin_claims__claim_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "title": "Claim Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminClaimOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "summary": "Update Claim"
      }
    },
    "/admin/import/{slug}": {
      "post": {
        "description": "Re-import an album's seed files.",
        "operationId": "import_seed_admin_import__slug__post",
        "parameters": [
          {
